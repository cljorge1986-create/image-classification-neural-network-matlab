classdef treinoimagens < matlab.apps.AppBase

    % Properties that correspond to app components
    properties (Access = public)
        UIFigure                    matlab.ui.Figure
        TabGroup                    matlab.ui.container.TabGroup
        ClassificationTab           matlab.ui.container.Tab
        ClearButton                 matlab.ui.control.Button
        wwwSiteButton               matlab.ui.control.Button
        Image                       matlab.ui.control.Image
        Resultado                   matlab.ui.control.TextArea
        ResultLabel                 matlab.ui.control.Label
        PCFileButton                matlab.ui.control.Button
        ImageURLorPCfileEditField   matlab.ui.control.EditField
        ImageURLorPCfileLabel       matlab.ui.control.Label
        ClassifiesButton            matlab.ui.control.Button
        TrainingTab                 matlab.ui.container.Tab
        ChooseCNNDropDown           matlab.ui.control.DropDown
        ChooseCNNDropDownLabel      matlab.ui.control.Label
        SelectAllButton             matlab.ui.control.Button
        UITable2                    matlab.ui.control.Table
        AVGimagenspfolderEditField  matlab.ui.control.NumericEditField
        AVGimagenspfolderEditFieldLabel  matlab.ui.control.Label
        openButton                  matlab.ui.control.Button
        MatrixConfusionLabel_2      matlab.ui.control.Label
        MatrixConfusionLabel        matlab.ui.control.Label
        UITable                     matlab.ui.control.Table
        accurate                    matlab.ui.control.NumericEditField
        AccurateLabel               matlab.ui.control.Label
        numberFoldersLabel          matlab.ui.control.Label
        RootFolder                  matlab.ui.control.EditField
        RootFolderEditFieldLabel    matlab.ui.control.Label
        Listadeimagesparatreino     matlab.ui.control.ListBox
        ListadeSubficheirosLabel    matlab.ui.control.Label
        TrainingButton              matlab.ui.control.Button
        SoundWIPTab                 matlab.ui.container.Tab
        PauseButton_2               matlab.ui.control.StateButton
        ReproduzirPanel             matlab.ui.container.Panel
        PathEditField               matlab.ui.control.EditField
        PathEditFieldLabel          matlab.ui.control.Label
        Button_2                    matlab.ui.control.Button
        StopButton                  matlab.ui.control.StateButton
        PauseButton                 matlab.ui.control.StateButton
        playButton                  matlab.ui.control.StateButton
        Lamp2                       matlab.ui.control.Lamp
        Lamp                        matlab.ui.control.Lamp
        RECButton                   matlab.ui.control.StateButton
        Spinner                     matlab.ui.control.Spinner
        VolumeSlider                matlab.ui.control.Slider
        VolumeSliderLabel           matlab.ui.control.Label
        Switch                      matlab.ui.control.ToggleSwitch
        ConfigsTab                  matlab.ui.container.Tab
        saveConfigFileButton        matlab.ui.control.Button
        configName                  matlab.ui.control.EditField
        loadConfigFileButton        matlab.ui.control.Button
    end

    
    properties (Access = private)
        system; % Description
    end
    
    methods (Access = private)
        function renewListFolders(app)
            [pathFolders,numberFolders] = listingFolders(app.RootFolder.Value);
            app.Listadeimagesparatreino.Items=pathFolders;
            app.Listadeimagesparatreino.Value=app.Listadeimagesparatreino.Items;
            app.numberFoldersLabel.Text=strcat('(',num2str(numberFolders-2), ')');
            
        end
        
        function resetAll(app)
           loadConfigFileButtonPushed(app);
           app.system.button.folder_name="Training";
           enable_disable_button(app, "All", 0);
        end

        function enable_disable_button(app, section, onOff)
            if onOff
                switch section
                    case app.system.button.folder_name
                        app.TrainingButton.Enable="on";
                    otherwise
                        app.TrainingButton.Enable="off";
                end
            else
                app.TrainingButton.Enable="off";
            end
        end
    end
    

    % Callbacks that handle component events
    methods (Access = private)

        % Code that executes after component creation
        function startupFcn(app, arg)
            % system speek
            soundFile('Welcome!'); % system speek
            resetAll(app);
            %ao iniciar carrego os dados
             [app.system.net, app.system.imageSize, app.system.classifier, ...
               app.accurate.Value, app.AVGimagenspfolderEditField.Value,...
               app.UITable.Data, app.UITable2.Data] = loadConfig(app.configName.Value);
            
            
        end

        % Button pushed function: TrainingButton
        function TrainingButtonPushed(app, event)
           if ~isempty(app.Listadeimagesparatreino.Value)
                renewListFolders(app);
           end
        switch app.ChooseCNNDropDown.Value
            case "MobileNetV2"
                choosed_cnn = "mobilenetv2";
            case "ResNet50"
                choosed_cnn = "resnet50";
            case "SqueezeNet"
                choosed_cnn = "squeezenet";
            otherwise
                choosed_cnn = "squeezenet";
        end
           [app.system.net, app.system.imageSize, app.system.classifier, app.accurate.Value, app.AVGimagenspfolderEditField.Value, ...
               app.UITable.Data, app.UITable2.Data, app.system.centroids, app.system.classes]...
               = treining_method_v2(app.RootFolder.Value, app.Listadeimagesparatreino.Value, choosed_cnn);
        end

        % Button pushed function: ClassifiesButton
        function ClassifiesButtonPushed(app, event)
            path = app.ImageURLorPCfileEditField.Value;
            if isempty(path)
                uialert(app.UIFigure, ...
                    'No Image.', ...
                    'Load Error');
                return;
            end
            if startsWith(path, "http", 'IgnoreCase', true)
                % URL (internet)
                img = webread(path);
            else
                % Ficheiro local
                img = imread(path);
            end
            
            if size(img,3)==1
                img = repmat(img,1,1,3);
            end

            %app.Image.ImageSource = img;
            
            img = imresize(img, app.system.imageSize(1:2));
            
            dlImg = dlarray(single(img),'SSC');
            
            imgFeatures = forward(app.system.net, dlImg);
            imgFeatures = extractdata(imgFeatures);
            
            scores = app.system.centroids' * imgFeatures;
            
            [~,idx] = max(scores);
            
            app.Resultado.Value = app.system.classes(idx);

            soundFile(cell2mat(app.Resultado.Value)); % system speek
            
        end

        % Button pushed function: PCFileButton
        function PCFileButtonPushed(app, event)
            app.ImageURLorPCfileEditField.Value=loadNewImage();
            app.Image.ImageSource=app.ImageURLorPCfileEditField.Value;
        end

        % Button pushed function: openButton
        function openButtonPushed(app, event)
            app.RootFolder.Value = open_training_folder(app.RootFolder.Value);
            renewListFolders(app);
            enable_disable_button(app, app.system.button.folder_name, 1);
        end

        % Button pushed function: saveConfigFileButton
        function saveConfigFileButtonPushed(app, event)
            saveConfig(app.configName.Value,{'NET'; 'IMAGESIZE'; 'CLASSIFIER'; 'ACCURATE'; 'IMG FILE';'MCONFUSION'; 'MCONFUSIONPER'; 'CENTROIDS'; 'CLASSES'},...
                {app.system.net; app.system.imageSize; app.system.classifier; app.accurate.Value;...
                app.AVGimagenspfolderEditField.Value; app.UITable.Data; app.UITable2.Data; app.system.centroids; app.system.classes});
        end

        % Button pushed function: loadConfigFileButton
        function loadConfigFileButtonPushed(app, event)
             [app.system.net, app.system.imageSize, app.system.classifier, ...
               app.accurate.Value, app.AVGimagenspfolderEditField.Value,...
               app.UITable.Data, app.UITable2.Data, app.system.centroids, app.system.classes] = loadConfig(app.configName.Value);
        end

        % Button pushed function: wwwSiteButton
        function wwwSiteButtonPushed(app, event)
            url = app.ImageURLorPCfileEditField.Value;
            try
                img = webread(url);
            
                if ~isnumeric(img) || ndims(img) < 2
                    uialert(app.UIFigure, ...
                        'The link is valid but does not contain an image.', ...
                        'Invalid Content');
                    return;
                end
            
                app.Image.ImageSource = img;
            
            catch ME
                uialert(app.UIFigure, ...
                    'Unable to load image from URL. Check the link or connection.', ...
                    'Load Error');
            end
        end

        % Button pushed function: ClearButton
        function ClearButtonPushed(app, event)
            app.ImageURLorPCfileEditField.Value='';
            app.Image.ImageSource = '';
        end

        % Value changed function: Switch
        function SwitchValueChanged(app, event)
            if strcmp(app.Switch.Value,'On')
                app.Lamp2.Color=[0 1 0];
                app.system.recObj = audiorecorder;
            else
                app.Lamp2.Color=[1 0 0];
            end
        end

        % Value changed function: VolumeSlider
        function VolumeSliderValueChanged(app, event)
            value = app.VolumeSlider.Value;
            set(app.Spinner,'Value',value);
        end

        % Value changed function: RECButton
        function RECButtonValueChanged(app, event)
            if app.RECButton.Value
                app.Lamp.Color=[0 1 0];
                record(app.system.recObj);
            else
                app.Lamp.Color=[1 0 0];
            end
        end

        % Value changed function: Spinner
        function SpinnerValueChanged(app, event)
            value = app.Spinner.Value;
            set(app.VolumeSlider,'Value',value);
        end

        % Value changed function: playButton
        function playButtonValueChanged(app, event)
            play(recObj);
        end

        % Value changed function: PauseButton
        function PauseButtonValueChanged(app, event)
            pause(recObj);            
        end

        % Value changed function: StopButton
        function StopButtonValueChanged(app, event)
            stop(recorder1);
        end

        % Button pushed function: SelectAllButton
        function SelectAllButtonPushed(app, event)
            % Select all items in ListBox
            app.Listadeimagesparatreino.Value = app.Listadeimagesparatreino.Items;
        end

        % Button down function: SoundWIPTab
        function SoundWIPTabButtonDown(app, event)
            app.TabGroup.SelectedTab = app.ClassificationTab;

            uialert(app.UIFigure, ...
                'This feature is not available yet.', ...
                'Work in progress');
        end
    end

